# ── La Toile d'Or — variables d'environnement ──
# Copier vers .env pour le développement local.
# En production, TOUT est défini dans les variables Railway. Ne jamais commiter .env.

# PostgreSQL (Railway fournit DATABASE_URL automatiquement via la référence du service)
DATABASE_URL="postgresql://toile:toile@localhost:5432/toile_dor"

# Secret de session (générer : openssl rand -base64 32)
AUTH_SECRET="changeme-genere-un-secret-aleatoire"

# Application Discord (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Token du bot — UNIQUEMENT si le service bot est déployé (optionnel :
# la configuration retenue fonctionne sans bot, notifications in-app)
DISCORD_BOT_TOKEN=""
# Identifiant du serveur Discord du RP (obligatoire pour restreindre l'accès)
DISCORD_GUILD_ID=""
# Identifiants de rôles Discord critiques (séparés par des virgules) :
# un utilisateur qui les perd tous est suspendu à la synchronisation
DISCORD_REQUIRED_ROLE_IDS=""

# Poivre des jetons d'invitation (générer : openssl rand -base64 32)
INVITE_TOKEN_PEPPER="changeme-genere-un-pepper-aleatoire"

# Clé de chiffrement des données au repos si nécessaire (32 octets base64)
ENCRYPTION_KEY="changeme-genere-une-cle-aleatoire"

# URL publique de l'application (Railway : https://<service>.up.railway.app)
APP_URL="http://localhost:3000"
