// La Toile d'Or — schéma de données
// Toutes les données de mission sont fictives et limitées au cadre du jeu de rôle.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Comptes, sessions, invitations
// ─────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING // invitation consommée, en attente d'approbation manuelle
  ACTIVE
  SUSPENDED // rôle Discord critique perdu, réactivable
  REVOKED
}

// Qui peut voir le prénom et le nom d'un membre — décidé par l'intéressé.
// La modération conserve l'accès dans tous les cas : elle en a besoin pour
// arbitrer, et c'est annoncé sur la page « Mes informations ».
enum IdentityVisibility {
  MODERATORS // la modération seule
  MY_GROUPS  // + les membres de ses propres groupes (règle historique)
  EVERYONE   // + tout membre autorisé de la Toile
}

model User {
  id            String     @id @default(cuid())
  // Pseudonyme public — seul nom visible hors du groupe et de la modération
  displayName   String
  // Forme normalisée (minuscules, espaces réduits) garantissant l'unicité
  // insensible à la casse. Nullable : rempli à l'onboarding, backfillé au mieux.
  displayNameNorm String?  @unique
  // ── Identité réelle du personnage : CONFIDENTIELLE ──
  // Visible uniquement par la modération et les membres du même groupe
  // (voir apps/web/server/identity.ts — jamais envoyée aux autres).
  firstName     String?
  lastName      String? // certains personnages n'ont pas de nom de famille
  // Qui peut voir ce prénom et ce nom — choix de l'intéressé.
  // MY_GROUPS reproduit la règle d'origine : les comptes existants ne voient
  // donc aucun changement tant qu'ils n'ont rien décidé.
  identityVisibility IdentityVisibility @default(MY_GROUPS)
  // Onboarding de première connexion
  profileCompleted     Boolean   @default(false)
  privacyAcknowledgedAt DateTime?
  // Fiche RP héritée (ancien onboarding) : titre (pseudo RP) et village/pays
  rpTitle       String?
  village       String?
  status        UserStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  lastLoginAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  revokedAt     DateTime?
  revokedReason String?
  // Préférence de confidentialité : démarrer en mode Streamer
  streamerModeDefault Boolean @default(false)
  // Niveau RP du personnage (configurable dans l'administration)
  playerLevelId String?

  playerLevel        PlayerLevel?    @relation("UserLevel", fields: [playerLevelId], references: [id])
  discordAccount     DiscordAccount?
  sessions           Session[]
  roles              UserRole[]
  factionMemberships FactionMember[]
  groupMemberships   GroupMember[]
  invitationsCreated Invitation[]            @relation("InvitationCreator")
  invitationUsed     Invitation?             @relation("InvitationUser")
  missionsCreated    Mission[]               @relation("MissionCreator")
  missionsModerated  Mission[]               @relation("MissionModerator")
  claims             MissionClaim[]          @relation("ClaimLeader")
  claimParticipations MissionClaimParticipant[]
  participations     MissionParticipant[]
  notificationPrefs  NotificationPreference[]
  notifications      NotificationDelivery[]
  auditLogs          AuditLog[]

  @@index([status])
}

model DiscordAccount {
  id         String   @id @default(cuid())
  userId     String   @unique
  discordId  String   @unique
  username   String
  globalName String?
  avatarHash String?
  // Rôles Discord observés lors de la dernière synchronisation (ids)
  guildRoles String[] @default([])
  syncedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String    @id @default(cuid())
  // Hash SHA-256 du jeton de session — le jeton clair ne vit que dans le cookie HttpOnly
  tokenHash  String    @unique
  // Identifiant court non sensible, affiché dans le filigrane
  shortId    String
  userId     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipTrunc    String? // IP tronquée (jamais l'adresse complète)
  userAgent  String? // réduit à famille navigateur/OS

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum InvitationStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

enum GroupOnboardingMode {
  NONE
  EXISTING_GROUP
  CREATE_NEW_GROUP
}

model Invitation {
  id        String           @id @default(cuid())
  // Hash SHA-256(token + INVITE_TOKEN_PEPPER) — jamais le jeton clair
  tokenHash String           @unique
  status    InvitationStatus @default(ACTIVE)
  note      String?
  createdAt DateTime         @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  // Rôle, faction et groupe pré-assignés à l'utilisateur qui consommera l'invitation
  roleId    String?
  factionId String?
  groupId   String?
  // Niveau attribué par l'inviteur et appliqué à la création du compte.
  playerLevelId String?
  // Parcours de groupe à la première connexion d'un chef :
  // EXISTING_GROUP → rattaché à groupId ; CREATE_NEW_GROUP → formulaire de création
  groupOnboardingMode GroupOnboardingMode @default(NONE)
  // Approbation manuelle exigée après l'OAuth Discord
  requireApproval Boolean @default(true)
  // Restriction facultative à un identifiant Discord précis
  restrictedDiscordId String?

  createdById String
  createdBy   User    @relation("InvitationCreator", fields: [createdById], references: [id])
  usedById    String? @unique
  usedBy      User?   @relation("InvitationUser", fields: [usedById], references: [id])
  usedAt      DateTime?
  role        Role?    @relation(fields: [roleId], references: [id])
  faction     Faction? @relation(fields: [factionId], references: [id])
  group       Group?   @relation(fields: [groupId], references: [id])
  playerLevel PlayerLevel? @relation(fields: [playerLevelId], references: [id])

  @@index([status, expiresAt])
  @@index([createdById])
}

// ─────────────────────────────────────────────────────────────
// Rôles et permissions (RBAC extensible, contrôlé côté serveur)
// ─────────────────────────────────────────────────────────────

model Role {
  id       String  @id @default(cuid())
  slug     String  @unique // super_admin, moderator, group_leader, group_member
  name     String
  isSystem Boolean @default(false)

  permissions RolePermission[]
  users       UserRole[]
  invitations Invitation[]
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // ex: mission.create, mission.view.confidential
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ─────────────────────────────────────────────────────────────
// Factions et groupes
// ─────────────────────────────────────────────────────────────

model Faction {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  // Couleur d'accent sémantique (référence de token, pas une valeur arbitraire)
  colorToken  String  @default("gold")
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())

  members      FactionMember[]
  groups       Group[]
  invitations  Invitation[]
  assignments  MissionAssignment[]
  scores       MissionScore[]
  missionsAssigned Mission[] @relation("MissionAssignedFaction")
  targetMissions   Mission[] @relation("MissionTargetFaction")
  characterProfiles CharacterProfile[] @relation("ProfileFaction")
}

model FactionMember {
  // Compatibilité historique. L'autorité et les accès passent désormais par
  // GroupMember ; une faction classe des groupes, elle ne dirige pas les utilisateurs.
  factionId String
  userId    String
  isLeader  Boolean  @default(false)
  joinedAt  DateTime @default(now())

  faction Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([factionId, userId])
  @@index([userId])
}

model Group {
  id        String   @id @default(cuid())
  // Rattachement facultatif : un groupe peut être indépendant.
  factionId String?
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdById String?
  // ── Fiche du groupe ──
  primaryCountry String?
  primaryVillage String?
  // Spécialités : même référentiel que les catégories de mission (source unique)
  specialties MissionCategory[] @default([])
  // Image stockée en base (Railway a un système de fichiers éphémère) —
  // limitée à 500 Ko, servie par une route authentifiée.
  imageData Bytes?
  imageMime String?

  faction     Faction?            @relation(fields: [factionId], references: [id], onDelete: SetNull)
  members     GroupMember[]
  claims      MissionClaim[]
  assignments MissionAssignment[]
  missionParticipants MissionParticipant[]
  scores      MissionScore[]
  missionsAssigned Mission[] @relation("MissionAssignedGroup")
  invitations Invitation[]
  profileRequests ProfilePurchaseRequest[] @relation("GroupProfileRequests")
  profileGrants   ProfileAccessGrant[]     @relation("GroupProfileGrants")

  @@unique([factionId, name])
}

model GroupMember {
  groupId  String
  userId   String
  isLeader Boolean  @default(false)
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Configuration RP : niveaux de joueurs et rangs de mission
// ─────────────────────────────────────────────────────────────

model PlayerLevel {
  id    String @id @default(cuid())
  slug  String @unique // genin_apprenti, genin_simple, ...
  label String // libellé configurable dans l'administration
  order Int    @unique // hiérarchie croissante

  missionsTarget Mission[] @relation("MissionTargetLevel")
  missionsMin    Mission[] @relation("MissionMinLevel")
  ranksMin       RankConfig[]
  users          User[]       @relation("UserLevel")
  invitations    Invitation[]
  characterProfiles CharacterProfile[] @relation("ProfileRank")
}

enum MissionRank {
  D
  C
  B
  A
  S
  SS
}

model RankConfig {
  rank                 MissionRank @id
  symbol               String
  colorToken           String // référence de token du design system
  dangerLevel          Int // 1..6
  rewardRyoMin         Int
  rewardRyoMax         Int
  defaultPoints        Int
  minLevelId           String?
  recommendedGroupSize Int

  minLevel PlayerLevel? @relation(fields: [minLevelId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// Missions
// ─────────────────────────────────────────────────────────────

enum MissionCategory {
  COLLECTE_INFORMATIONS
  SURVEILLANCE_ESPIONNAGE
  ELIMINATION
  ENLEVEMENT
  INTERROGATOIRE
  PROTECTION
  ESCORTE
  SABOTAGE
  MERCENARIAT
  SPECIALE
  INFILTRATION
  TRAQUE
  CONTRE_ESPIONNAGE
  GUERRE
}

enum MissionStatus {
  DRAFT
  AVAILABLE
  CLAIM_PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
  ARCHIVED
}

// Politique d'application des critères d'éligibilité
enum EligibilityMode {
  RECOMMENDATION
  WARNING
  STRICT
  MANUAL_REVIEW
}

model Mission {
  id     String          @id @default(cuid())
  code   String          @unique // ex: TO-A-0042
  status MissionStatus   @default(DRAFT)
  rank   MissionRank
  category MissionCategory

  // ── Données publiques (visibles avant attribution selon MissionVisibility)
  publicTitle          String
  publicSummary        String?
  rewardRyoMin         Int
  rewardRyoMax         Int
  // Montant exact choisi à l'accomplissement puis partagé entre participants.
  awardedRyo           Int?
  basePoints           Int
  targetLevelId        String?
  minRecommendedLevelId String?
  groupSizeMin         Int    @default(1)
  groupSizeMax         Int    @default(4)

  // ── Données confidentielles (groupe attribué + modérateurs uniquement)
  confidentialDescription String?
  primaryObjective        String?
  secondaryObjectives     Json? // [{label, secret: bool, points}]
  targetIdentity          String? // chefs des groupes attribués + modération
  // Dossier de renseignement de la cible, quand elle en a un. Le texte libre
  // reste la source d'affichage ; ce lien ouvre la fiche et laisse verser les
  // renseignements de la mission dans le bon dossier. MÊME confidentialité
  // que targetIdentity : ne jamais l'exposer plus largement.
  // DÉPRÉCIÉ : conservé pour ne rien perdre des missions déjà saisies. Les
  // cibles vivent désormais dans `targets` — une mission peut en viser
  // plusieurs, et chacune a son propre sort.
  targetProfileId         String?
  // Réservée aux chefs des groupes attribués et à la modération.
  targetFactionId         String?
  location                String?
  clientName              String? // commanditaire — modération uniquement
  // Dossier du commanditaire — modération uniquement, comme clientName.
  clientProfileId         String?
  constraints             String?
  prohibitions            String?
  evidence                String? // preuves à rapporter

  // ── Données réservées aux modérateurs
  internalTitle   String?
  moderatorNotes  String?
  eligibilityMode EligibilityMode @default(WARNING)

  // ── Délais (temps réel UTC ; conversion RP via le service central)
  createdAt          DateTime  @default(now())
  publishedAt        DateTime?
  expiresAt          DateTime? // null = sans limite de temps
  // Suspension temporaire du délai : on mémorise le temps restant
  timerSuspendedAt   DateTime?
  timerRemainingMs   BigInt?

  // ── Attribution et résolution
  assignedFactionId String?
  assignedGroupId   String?
  assignedAt        DateTime?
  resolvedAt        DateTime?
  failureReason     String?
  cancellationReason String?

  creatorId             String
  responsibleModeratorId String?

  creator             User     @relation("MissionCreator", fields: [creatorId], references: [id])
  responsibleModerator User?   @relation("MissionModerator", fields: [responsibleModeratorId], references: [id])
  targetLevel         PlayerLevel? @relation("MissionTargetLevel", fields: [targetLevelId], references: [id])
  targetFaction       Faction? @relation("MissionTargetFaction", fields: [targetFactionId], references: [id], onDelete: SetNull)
  targetProfile       CharacterProfile? @relation("MissionTargetProfile", fields: [targetProfileId], references: [id], onDelete: SetNull)
  clientProfile       CharacterProfile? @relation("MissionClientProfile", fields: [clientProfileId], references: [id], onDelete: SetNull)
  minRecommendedLevel PlayerLevel? @relation("MissionMinLevel", fields: [minRecommendedLevelId], references: [id])
  assignedFaction     Faction? @relation("MissionAssignedFaction", fields: [assignedFactionId], references: [id])
  assignedGroup       Group?   @relation("MissionAssignedGroup", fields: [assignedGroupId], references: [id])

  targets       MissionTarget[]
  visibility    MissionVisibility?
  claims        MissionClaim[]
  assignments   MissionAssignment[]
  participants  MissionParticipant[]
  attachments   MissionAttachment[]
  statusHistory MissionStatusHistory[]
  reports       MissionReport[]
  scores        MissionScore[]
  notifications NotificationDelivery[]
  intelSources  CharacterFieldIntel[]  @relation("IntelSourceMission")

  @@index([status, rank])
  @@index([status, expiresAt])
  @@index([assignedGroupId])
  @@index([assignedFactionId])
  @@index([targetFactionId])
  @@index([publishedAt])
}

// Ce que les chefs de groupe voient AVANT attribution.
// Le rang, la récompense, le temps restant et les tailles de groupe sont toujours publics.
model MissionVisibility {
  missionId       String  @id
  showCategory    Boolean @default(true)
  showTargetLevel Boolean @default(true)
  showSummary     Boolean @default(true)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

enum ClaimStatus {
  PENDING
  ACCEPTED
  REJECTED
  INFO_REQUESTED
  WITHDRAWN
}

model MissionClaim {
  id        String      @id @default(cuid())
  missionId String
  groupId   String
  leaderId  String
  message   String?
  status    ClaimStatus @default(PENDING)
  createdAt DateTime    @default(now())
  resolvedAt DateTime?
  moderatorId String?
  moderatorNote String?
  // Effectif proposé par le chef (validé côté serveur, borné à l'effectif réel)
  proposedHeadcount Int?
  // Avertissements d'éligibilité calculés au moment de la revendication
  warnings  Json?
  // Le chef autorise l'affichage public du nom du groupe et des pseudonymes
  // des agents proposés. Faux par défaut : la modération voit toujours tout.
  publicRoster Boolean @default(false)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  leader  User    @relation("ClaimLeader", fields: [leaderId], references: [id])
  participants MissionClaimParticipant[]

  // Empêche les revendications dupliquées d'un même groupe sur une mission
  @@unique([missionId, groupId])
  @@index([status])
  @@index([missionId, status])
}

// Agents nommément engagés par le chef lors d'une revendication.
// Ils n'obtiennent l'accès à la mission qu'après acceptation.
model MissionClaimParticipant {
  claimId String
  userId  String

  claim MissionClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([claimId, userId])
  @@index([userId])
}

// Une mission peut être menée par PLUSIEURS groupes (attributions actives
// simultanées). L'unicité mission+groupe active est garantie par un index
// partiel PostgreSQL (voir migration identity_groups_multiassign).
model MissionAssignment {
  id           String    @id @default(cuid())
  missionId    String
  factionId    String?
  groupId      String
  assignedById String
  assignedAt   DateTime  @default(now())
  active       Boolean   @default(true)
  releasedAt   DateTime?
  releasedReason String?
  // Effectif engagé par ce groupe sur la mission
  assignedHeadcount Int @default(1)
  // Groupe principal / coordinateur (au plus un par mission)
  isLeadGroup Boolean @default(false)
  // Copié depuis la revendication du chef. N'expose que le groupe et les
  // pseudonymes publics, jamais les identités réelles ou le dossier mission.
  publicRoster Boolean @default(false)
  notes       String?

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  faction Faction? @relation(fields: [factionId], references: [id], onDelete: SetNull)
  group   Group   @relation(fields: [groupId], references: [id])

  @@index([missionId, active])
  @@index([groupId, active])
}

// Sort d'une cible à la résolution. UNKNOWN tant que rien n'est constaté :
// une mission accomplie ne dit pas forcément ce qu'il est advenu de chacun.
enum MissionTargetOutcome {
  UNKNOWN
  ELIMINATED // cible tuée
  CAPTURED   // capturée vivante
  ESCAPED    // en fuite
  UNHARMED   // épargnée ou jamais atteinte
  MISSING    // disparue
}

// Cible d'une mission. Une mission peut en viser PLUSIEURS, et chacune a son
// propre sort : « mission accomplie » ne signifie pas que toutes sont mortes.
// Le dossier est facultatif — une cible peut n'être qu'un nom sans fiche.
model MissionTarget {
  id        String  @id @default(cuid())
  missionId String
  profileId String?
  // Nom libre quand la cible n'a pas (encore) de dossier
  label     String?
  outcome   MissionTargetOutcome @default(UNKNOWN)
  note      String?
  // Qui a constaté le sort de cette cible, et quand
  recordedAt   DateTime?
  recordedById String?
  createdAt DateTime @default(now())

  mission Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  profile CharacterProfile? @relation("MissionTargets", fields: [profileId], references: [id], onDelete: SetNull)

  // Une même cible n'apparaît qu'une fois par mission
  @@unique([missionId, profileId])
  @@index([missionId])
  @@index([profileId])
}

model MissionParticipant {
  missionId String
  userId    String
  groupId   String?
  addedById String
  addedAt   DateTime @default(now())
  note      String?
  // Parts finales attribuées à cet agent à la résolution.
  pointsAwarded Int @default(0)
  ryoAwarded    Int @default(0)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@id([missionId, userId])
  @@index([userId])
  @@index([missionId, groupId])
}

model MissionAttachment {
  id           String   @id @default(cuid())
  missionId    String
  fileName     String
  mimeType     String
  sizeBytes    Int
  // Clé de stockage opaque — jamais d'URL directe publique
  storageKey   String   @unique
  confidential Boolean  @default(true)
  uploadedById String
  createdAt    DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
}

model MissionStatusHistory {
  id          String        @id @default(cuid())
  missionId   String
  fromStatus  MissionStatus
  toStatus    MissionStatus
  changedById String
  reason      String?
  createdAt   DateTime      @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, createdAt])
}

model MissionReport {
  id          String    @id @default(cuid())
  missionId   String
  authorId    String
  content     String
  submittedAt DateTime  @default(now())
  isFinal     Boolean   @default(false)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
}

// ─────────────────────────────────────────────────────────────
// Points et classement
// ─────────────────────────────────────────────────────────────

model LeaderboardSeason {
  id       String   @id @default(cuid())
  name     String
  startsAt DateTime
  endsAt   DateTime?
  isActive Boolean  @default(false)

  scores MissionScore[]
}

enum ScoreReason {
  MISSION_COMPLETED
  MISSION_FAILED
  SPEED_BONUS
  STEALTH_BONUS
  SECONDARY_OBJECTIVES
  REPORT_QUALITY
  ADMIN_PENALTY
  ABANDON
  RP_VIOLATION
  MANUAL_ADJUSTMENT
}

// Registre : chaque attribution de points est une ligne immuable et justifiée
model MissionScore {
  id          String      @id @default(cuid())
  missionId   String?
  seasonId    String?
  factionId   String?
  groupId     String?
  points      Int // positif ou négatif
  reason      ScoreReason
  justification String?
  createdById String
  createdAt   DateTime    @default(now())

  mission Mission?           @relation(fields: [missionId], references: [id], onDelete: SetNull)
  season  LeaderboardSeason? @relation(fields: [seasonId], references: [id])
  faction Faction?           @relation(fields: [factionId], references: [id], onDelete: SetNull)
  group   Group?             @relation(fields: [groupId], references: [id])

  @@index([factionId, seasonId])
  @@index([groupId, seasonId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Notifications Discord
// ─────────────────────────────────────────────────────────────

enum NotificationEvent {
  PROFILE_REQUEST_CREATED
  PROFILE_REQUEST_APPROVED
  PROFILE_REQUEST_REFUSED
  PROFILE_UPDATED
  MEMBER_PROMOTED
  MISSION_AVAILABLE
  CLAIM_ACCEPTED
  CLAIM_REJECTED
  CLAIM_INFO_REQUESTED
  MISSION_UPDATED
  MISSION_STATUS_CHANGED
  MISSION_DEADLINE_SOON
  MISSION_EXPIRED
  MISSION_CANCELLED
  NEW_CLAIM
  CLAIM_WITHDRAWN
  FINAL_REPORT_SUBMITTED
  SYNC_ISSUE
  ACCESS_DENIED_ALERT
}

enum NotificationFrequency {
  IMMEDIATE
  DIGEST_HOURLY
  DIGEST_DAILY
}

model NotificationPreference {
  id        String                @id @default(cuid())
  userId    String
  event     NotificationEvent
  enabled   Boolean               @default(true)
  frequency NotificationFrequency @default(IMMEDIATE)
  // Filtres facultatifs : rangs et catégories qui intéressent l'utilisateur
  rankFilter     MissionRank[]     @default([])
  categoryFilter MissionCategory[] @default([])
  // Période silencieuse (heures locales 0-23), désactivation temporaire
  quietHourStart Int?
  quietHourEnd   Int?
  mutedUntil     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, event])
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// File de notifications : le web écrit, le bot consomme. Historique conservé.
model NotificationDelivery {
  id            String            @id @default(cuid())
  userId        String
  event         NotificationEvent
  payload       Json // contenu non confidentiel prêt à l'envoi en DM
  missionId     String?
  status        DeliveryStatus    @default(PENDING)
  attempts      Int               @default(0)
  nextAttemptAt DateTime          @default(now())
  sentAt        DateTime?
  lastError     String?
  // Clé de regroupement pour éviter le spam (digest)
  batchKey      String?
  createdAt     DateTime          @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Audit et configuration
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String // ex: mission.status_changed, invite.used, auth.login_failed
  resourceType String?
  resourceId   String?
  createdAt    DateTime @default(now())
  ipHash       String? // hash tronqué, jamais l'IP complète
  userAgent    String? // réduit
  oldValues    Json?
  newValues    Json?
  reason       String?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
}

// Paramètres applicatifs configurables (ratio temps RP, verrous, libellés…)
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedById String?
}

// ─────────────────────────────────────────────────────────────
// Dossiers de renseignement (profils de personnages RP)
// Entité DISTINCTE des comptes utilisateurs : un CharacterProfile décrit un
// personnage recherché/observé du RP, jamais un joueur.
// ─────────────────────────────────────────────────────────────

// État de connaissance d'une information du dossier.
// UNKNOWN → « Inconnu » (la Toile ne sait pas) — visible par tous.
// KNOWN → valeur réelle pour les autorisés, « ??? » pour les autres.
// NONE_CONFIRMED → « Aucun » pour les autorisés, « ??? » pour les autres.
// CONFLICTING → « Information contradictoire » / « ??? ».
// Les textes « Inconnu » et « ??? » ne sont JAMAIS stockés : ils sont calculés.
enum ProfileKnowledgeState {
  UNKNOWN
  KNOWN
  NONE_CONFIRMED
  CONFLICTING
}

enum IntelConfidence {
  RUMOR
  UNCONFIRMED
  PROBABLE
  CONFIRMED
}

enum ProfileLifeStatus {
  ALIVE
  DEAD
  MISSING
}

enum ProfileSex {
  MALE
  FEMALE
  OTHER
}

// Mode de calcul de l'âge — TOUJOURS dérivé du service central de temps RP,
// à partir d'instants réels UTC de référence (jamais un âge figé à la main).
enum ProfileAgeMode {
  UNKNOWN
  BIRTH_DATE_RP
  AGE_AT_REFERENCE
  AGE_RANGE_AT_REFERENCE
}

enum ReferenceSourceScope {
  MANGA_CANON
  ANIME
  FILM
  GAME
  SERVER_CUSTOM
}

enum ReferenceSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
}

enum ProfileRequestStatus {
  PENDING
  APPROVED
  REFUSED
  CANCELLED
}

// Relations stockées sous forme CANONIQUE uniquement ; les inverses
// (enfant de, création de) sont dérivées à la lecture — jamais dupliquées.
enum ProfileRelationType {
  PARENT_OF
  CREATOR_OF
  SIBLING_OF // fromProfileId < toProfileId, imposé par le service
}

// Référentiel contrôlé et administrable (couleurs, clans, natures, KG,
// styles, artefacts…). `type` est une String volontairement : la liste des
// types est extensible sans migration (constantes dans @toile/shared).
model ProfileReferenceOption {
  id              String   @id @default(cuid())
  type            String // HAIR_COLOR, SKIN_TONE, CLAN_FAMILY, CHAKRA_NATURE, KEKKEI_GENKAI, JUTSU_TYPE, COMBAT_STYLE, KENJUTSU_STYLE, LEGENDARY_ARTIFACT
  code            String
  label           String
  normalizedLabel String // minuscules sans accents — anti-doublons (Uchiha/UCHIWA/Uchïha)
  aliases         String[] @default([])
  kanji           String?
  romaji          String?
  // Sous-catégorie métier (BASIC_ELEMENT, KEKKEI_TOTA, DOJUTSU, Sept Épées…)
  category        String?
  // Aperçu visuel (teintes de peau, couleurs de cheveux)
  colorHex        String?
  descriptionShort String?
  sourceUrl       String?
  sourceScope     ReferenceSourceScope @default(SERVER_CUSTOM)
  metadata        Json?
  sortOrder       Int      @default(100)
  // Artefacts uniques : avertit (sans bloquer) si porté par plusieurs vivants
  isUnique        Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdById     String?
  approvedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  traits           CharacterProfileTrait[]
  hairProfiles     CharacterProfile[] @relation("ProfileHairColor")
  skinProfiles     CharacterProfile[] @relation("ProfileSkinTone")
  techniques       CharacterSignatureTechnique[] @relation("TechniqueJutsuType")
  mergedSuggestions ProfileReferenceSuggestion[] @relation("SuggestionMergedInto")

  @@unique([type, code])
  @@unique([type, normalizedLabel])
  @@index([type, isActive, sortOrder])
}

// Proposition d'une nouvelle entrée de référentiel (validée par un super-mod)
model ProfileReferenceSuggestion {
  id            String  @id @default(cuid())
  type          String
  proposedLabel String
  description   String?
  sourceUrl     String?
  sourceScope   ReferenceSourceScope @default(SERVER_CUSTOM)
  reason        String?
  status        ReferenceSuggestionStatus @default(PENDING)
  createdById   String
  reviewedById  String?
  reviewNote    String?
  mergedIntoId  String?
  createdAt     DateTime @default(now())
  reviewedAt    DateTime?

  mergedInto ProfileReferenceOption? @relation("SuggestionMergedInto", fields: [mergedIntoId], references: [id])

  @@index([status, type])
}

model CharacterProfile {
  id   String @id @default(cuid())
  // Code lisible PRF-000142, dérivé d'un compteur auto-incrémenté
  codeNumber Int    @unique @default(autoincrement())
  code       String @unique

  // ── Identité (seul le prénom est obligatoire ; il n'est PAS unique) ──
  characterFirstName String
  firstNameNorm      String // minuscules/espaces réduits — détection de doublons
  characterLastName  String?
  sexCode            ProfileSex?

  // Portrait stocké en base (FS Railway éphémère), servi par route authentifiée
  imageData Bytes?
  imageMime String?

  // ── Apparence ── (plage en cm, jamais une chaîne « 180-190 cm »)
  heightMinCm Int?
  heightMaxCm Int?
  hairColorId String?
  skinToneId  String?

  // ── Affiliation ──
  factionId String? // réutilise la table Faction existante
  rankId    String? // réutilise le référentiel PlayerLevel existant

  // ── État vital + âge (références en temps réel UTC ; conversion RP centralisée) ──
  lifeStatus         ProfileLifeStatus?
  ageMode            ProfileAgeMode @default(UNKNOWN)
  birthRealAt        DateTime? // instant réel où l'âge RP du personnage était 0
  ageYearsAtRef      Int?
  ageMinAtRef        Int?
  ageMaxAtRef        Int?
  ageReferenceRealAt DateTime? // instant réel de l'observation de l'âge
  statusChangedRealAt DateTime?
  deathRealAt        DateTime? // fige l'âge d'un personnage mort
  missingSinceRealAt DateTime? // un disparu continue de vieillir

  // ── Analyse (texte brut multiligne, jamais de HTML) ──
  details   String?
  strengths String?
  weaknesses String?
  // Notes internes : JAMAIS incluses dans un dossier acheté
  internalNotes String?

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  archivedAt  DateTime?
  mergedIntoId String? // redirection après fusion de doublons
  version     Int       @default(1)

  hairColor ProfileReferenceOption? @relation("ProfileHairColor", fields: [hairColorId], references: [id])
  skinTone  ProfileReferenceOption? @relation("ProfileSkinTone", fields: [skinToneId], references: [id])
  faction   Faction?     @relation("ProfileFaction", fields: [factionId], references: [id])
  rank      PlayerLevel? @relation("ProfileRank", fields: [rankId], references: [id])
  mergedInto CharacterProfile? @relation("ProfileMerge", fields: [mergedIntoId], references: [id])
  mergedFrom CharacterProfile[] @relation("ProfileMerge")

  fieldIntel    CharacterFieldIntel[]
  traits        CharacterProfileTrait[]
  techniques    CharacterSignatureTechnique[]
  relationsFrom CharacterRelationship[] @relation("RelFrom")
  relationsTo   CharacterRelationship[] @relation("RelTo")
  revisions     CharacterProfileRevision[]
  purchaseRequests ProfilePurchaseRequest[]
  accessGrants  ProfileAccessGrant[]
  // Missions où ce personnage est la cible ou le commanditaire
  missionsAsTarget Mission[] @relation("MissionTargetProfile")
  missionsAsClient Mission[] @relation("MissionClientProfile")
  targetedBy       MissionTarget[] @relation("MissionTargets")

  @@index([firstNameNorm])
  @@index([archivedAt])
  @@index([factionId])
}

// État de connaissance par champ (fieldKey ∈ @toile/shared PROFILE_FIELD_KEYS).
// L'absence de ligne vaut UNKNOWN — règle centralisée dans le sérialiseur.
model CharacterFieldIntel {
  id         String                @id @default(cuid())
  profileId  String
  fieldKey   String
  knowledgeState ProfileKnowledgeState @default(KNOWN)
  confidence IntelConfidence?
  sourceMissionId String?
  sourceNote String?
  observedAtRp String? // libellé RP libre (« 12e jour du mois de la Brume, an 42 »)
  updatedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  profile CharacterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sourceMission Mission? @relation("IntelSourceMission", fields: [sourceMissionId], references: [id])

  @@unique([profileId, fieldKey])
  @@index([sourceMissionId])
}

// Liaison générique profil ↔ option de référentiel (natures, KG, clans,
// styles, sous-styles Kenjutsu, artefacts). Le type vient de l'option —
// même pouvoir de filtre que six tables dédiées, sans duplication.
model CharacterProfileTrait {
  profileId String
  optionId  String
  addedById String?
  createdAt DateTime @default(now())

  profile CharacterProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  option  ProfileReferenceOption @relation(fields: [optionId], references: [id])

  @@id([profileId, optionId])
  @@index([optionId])
}

// « Subjutsu » : techniques propres/signatures d'un personnage
model CharacterSignatureTechnique {
  id               String  @id @default(cuid())
  profileId        String
  name             String
  shortDescription String?
  jutsuTypeId      String?
  rank             MissionRank? // échelle D→SS réutilisée
  knowledgeState   ProfileKnowledgeState @default(KNOWN)
  confidence       IntelConfidence?
  sourceMissionId  String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  profile   CharacterProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jutsuType ProfileReferenceOption? @relation("TechniqueJutsuType", fields: [jutsuTypeId], references: [id])

  @@index([profileId])
}

model CharacterRelationship {
  id            String @id @default(cuid())
  fromProfileId String
  toProfileId   String
  type          ProfileRelationType
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())

  fromProfile CharacterProfile @relation("RelFrom", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfile   CharacterProfile @relation("RelTo", fields: [toProfileId], references: [id], onDelete: Cascade)

  @@unique([fromProfileId, toProfileId, type])
  @@index([toProfileId])
}

// Historique : aucune information n'est remplacée silencieusement
model CharacterProfileRevision {
  id         String  @id @default(cuid())
  profileId  String
  fieldKey   String
  oldValue   Json?
  newValue   Json?
  changedById String?
  sourceMissionId String?
  confidence IntelConfidence?
  justification String?
  createdAt  DateTime @default(now())

  profile CharacterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

// Demande d'accès (achat) d'un dossier par un groupe.
// Une seule demande PENDING par (profil, groupe) — index partiel en migration.
model ProfilePurchaseRequest {
  id            String  @id @default(cuid())
  profileId     String
  groupId       String
  requestedById String
  message       String?
  status        ProfileRequestStatus @default(PENDING)
  // Aucun portefeuille de Ryōs n'existe : le prix convenu est enregistré et
  // le règlement se fait manuellement en RP (limite documentée).
  priceRyos     Int?
  moderatorResponse String?
  reviewedById  String?
  requestedAt   DateTime @default(now())
  reviewedAt    DateTime?

  profile CharacterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  group   Group            @relation("GroupProfileRequests", fields: [groupId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt])
  @@index([groupId, status])
}

// Autorisation d'accès d'un groupe à un dossier (révocable).
// Un seul accès actif par (profil, groupe) — index partiel en migration.
model ProfileAccessGrant {
  id          String  @id @default(cuid())
  profileId   String
  groupId     String
  grantedById String
  requestId   String?
  priceRyos   Int?
  grantedAt   DateTime @default(now())
  revokedAt   DateTime?
  revokedById String?

  profile CharacterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  group   Group            @relation("GroupProfileGrants", fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, revokedAt])
  @@index([profileId, revokedAt])
}
